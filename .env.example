# Copy to .env next to docker-compose.yml. Compose reads it with env_file, so it is
# required to start -- a missing key is better as a failure to boot than as a bot that
# answers everything with an auth error.

# Production default model (deepseek/deepseek-v4-flash)
DEEPSEEK_API_KEY=

# Optional LiteLLM override, e.g. openrouter/<model> or nvidia_nim/<model>
# MODEL=

# OpenAI embeddings (text-embedding-3-large). Needed per search query, not just at ingest:
# the student's question is embedded before the pgvector lookup.
OPEN_AI_KEY=

# Description generation during `docker compose run --rm ingest`. Not needed to serve the
# seeded database.
NVIDIA_API_KEY=

# Postgres. Compose sets this to the books-db service, so leave it alone unless you are
# running the app on the host against the published port:
# JAFET_PG_DSN=postgresql://jafet:jafet@127.0.0.1:5433/jafet_books

# 1 = actually submit reservations to LibCal. Off by default: bookings are validated,
# stored as dry_run, and never sent. Read the warning in the README before flipping this.
LIVE_BOOKING=0
