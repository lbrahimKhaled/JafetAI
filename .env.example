# Copy to .env. Both server.py and agent_client.py read it.

# Model for the agent (OpenAI Agents SDK model name). The default goes through LiteLLM
# and only needs a DeepSeek key:
# MODEL=litellm/deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=

# Or use OpenAI directly: set MODEL to an OpenAI model name (e.g. gpt-4.1-mini) and
# OPENAI_API_KEY. With an OpenAI key set, runs are also traced in the OpenAI dashboard.
# OPENAI_API_KEY=

# 1 = actually submit reservations to LibCal. Off by default: bookings are validated,
# recorded as dry_run in jafet.db, and never sent. Leave it off for the demo.
LIVE_BOOKING=0
